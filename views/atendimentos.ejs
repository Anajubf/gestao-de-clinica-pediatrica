<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Atendimentos</title>
</head>
<body>
    <h1>Cadastro de Atendimentos</h1>
    <a href="/">Início</a>
    <a href="/atendimentos/novo">Novo atendimento</a>

    <table border="1" cellpadding="8">
        <tr>
            <th>ID</th>
            <th>Criança</th>
            <th>Responsável</th>
            <th>Data</th>
            <th>Horário</th>
            <th>Motivo</th>
            <th>Situação</th>
            <th>Ações</th>
        </tr>

        <% atendimentos.forEach(a => { %>
            <tr>
                <td><%= a.id %></td>
                <td><%= a.crianca %></td>
                <td><%= a.responsavel %></td>
                <td><%= new Date(a.data_atendimento).toLocaleDateString('pt-BR', { timeZone: 'UTC' }) %></td>
                <td><%= String(a.horario).slice(0, 5) %></td>
                <td><%= a.motivo %></td>
                <td><%= a.situacao %></td>
                <td>
                    <a href="/atendimentos/editar/<%= a.id %>">Editar</a>
                    <form action="/atendimentos/deletar/<%= a.id %>" method="POST" style="display:inline">
                        <button type="submit">Excluir</button>
                    </form>
                </td>
            </tr>
        <% }) %>
    </table>
</body>
</html>