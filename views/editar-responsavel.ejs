<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Editar Responsável</title>
</head>
<body>
    <h1>Editar Responsável</h1>

    <form action="/editar-responsavel/<%= responsavel.id %>" method="POST">

        <label>Nome:</label>
        <input type="text" name="nome"
               value="<%= responsavel.nome %>" required>

        <br><br>

        <label>CPF:</label>
        <input type="text" name="cpf"
               value="<%= responsavel.cpf %>" required>

        <br><br>

        <label>E-mail:</label>
        <input type="email" name="email"
               value="<%= responsavel.email %>" required>

        <br><br>

        <label>Telefone:</label>
        <input type="text" name="telefone"
               value="<%= responsavel.telefone %>" required>

        <br><br>

        <button type="submit">Salvar alterações</button>
    </form>

    <a href="/responsaveis">Voltar</a>
</body>
</html>