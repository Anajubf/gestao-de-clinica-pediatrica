<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Login - Clínica Pequenos Passos</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="login-box">
        <h1>Clínica Pediátrica Pequenos Passos</h1>
        <h2 style="text-align: center; font-size: 1.1rem; color: #64748b; margin-bottom: 1.5rem;">Login</h2>

        <% if (erro) { %>
            <div class="alerta-erro"><%= erro %></div>
        <% } %>

        <form action="/login" method="POST">
            <div class="form-group">
                <label for="cpf">CPF:</label>
                <input type="text" id="cpf" name="cpf" maxlength="14" placeholder="000.000.000-00" required>
            </div>

            <div class="form-group">
                <label for="senha">Senha:</label>
                <input type="password" id="senha" name="senha" required>
            </div>

            <button type="submit" style="width: 100%; margin-top: 0.5rem;">Entrar</button>
        </form>
    </div>
</body>
</html>