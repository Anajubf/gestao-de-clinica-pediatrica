<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Novo Atendimento - Clínica Pequenos Passos</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <h1>Clínica Pequenos Passos</h1>
        <nav>
            <a href="/">Início</a>
            <a href="/responsaveis">Responsáveis</a>
            <a href="/criancas">Crianças</a>
            <a href="/atendimentos">Atendimentos</a>
            <form action="/logout" method="POST" style="display:inline;">
                <button type="submit" class="btn-danger">Sair</button>
            </form>
        </nav>
    </header>

    <div class="container" style="max-width: 600px;">
        <h2 style="margin-bottom: 1.5rem;">Novo Atendimento</h2>

        <% if (typeof erro !== 'undefined' && erro) { %>
            <div class="alerta-erro"><%= erro %></div>
        <% } %>

        <form action="/atendimentos/novo" method="POST">
            <div class="form-group">
                <label for="crianca_id">Criança:</label>
                <select id="crianca_id" name="crianca_id" required>
                    <option value="">Selecione uma criança</option>
                    <% criancas.forEach(c => { %>
                        <option value="<%= c.id %>">
                            <%= c.nome %><%= c.nome_responsavel ? ` (Resp.: ${c.nome_responsavel})` : '' %>
                        </option>
                    <% }) %>
                </select>
            </div>

            <div class="form-group">
                <label for="data_atendimento">Data:</label>
                <input type="date" id="data_atendimento" name="data_atendimento" required>
            </div>

            <div class="form-group">
                <label for="horario">Horário:</label>
                <input type="time" id="horario" name="horario" required>
            </div>

            <div class="form-group">
                <label for="motivo">Motivo:</label>
                <input type="text" id="motivo" name="motivo" required>
            </div>

            <div class="form-group">
                <label for="situacao">Situação:</label>
                <select id="situacao" name="situacao" required>
                    <option value="Agendado">Agendado</option>
                    <option value="Em Atendimento">Em Atendimento</option>
                    <option value="Concluído">Concluído</option>
                    <option value="Cancelado">Cancelado</option>
                </select>
            </div>

            <div style="display: flex; gap: 0.75rem; margin-top: 1.5rem;">
                <button type="submit">Cadastrar</button>
                <a href="/atendimentos" class="btn btn-secondary">Voltar</a>
            </div>
        </form>
    </div>
</body>
</html>