<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Responsáveis</title>
</head>
<body>
    <h1>Cadastro de Responsáveis</h1>
    <a href="/">Início</a>
    <a href="/responsaveis/novo">Novo responsável</a>

    <% if (erro) { %>
        <p style="color: red;"><%= erro %></p>
    <% } %>

    <form action="/responsaveis" method="GET">
        <input type="text" name="busca" placeholder="Pesquisar por nome" value="<%= busca %>">
        <button type="submit">Buscar</button>
    </form>

    <table border="1" cellpadding="8">
        <tr>
            <th>ID</th>
            <th>Nome</th>
            <th>CPF</th>
            <th>E-mail</th>
            <th>Telefone</th>
            <th>Ações</th>
        </tr>

        <% responsaveis.forEach(r => { %>
            <tr>
                <td><%= r.id %></td>
                <td><%= r.nome %></td>
                <td><%= r.cpf %></td>
                <td><%= r.email %></td>
                <td><%= r.telefone %></td>
                <td>
                    <a href="/responsaveis/editar/<%= r.id %>">Editar</a>
                    <form action="/responsaveis/deletar/<%= r.id %>" method="POST" style="display:inline">
                        <button type="submit">Excluir</button>
                    </form>
                </td>
            </tr>
        <% }) %>
    </table>
</body>
</html>